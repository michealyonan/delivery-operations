EXPO_PUBLIC_SUPABASE_URL=https://jhnonbhgupyafgdxqzul.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=Set-Location 'C:\Users\Mr\Documents\DeliveryApp'; $secureKey = Read-Host 'Paste Supabase Publishable key (input hidden)' -AsSecureString; $keyPtr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureKey); try { $publishableKey = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($keyPtr); @('EXPO_PUBLIC_SUPABASE_URL=https://jhnonbhgupyafgdxqzul.supabase.co', "EXPO_PUBLIC_SUPABASE_ANON_KEY=$publishableKey", 'GOOGLE_MAPS_API_KEY=', 'EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=') | Set-Content -Path '.env' -Encoding ascii; Write-Host 'Saved Supabase settings to ignored local .env.' } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($keyPtr); $publishableKey = $null; $secureKey.Dispose() }
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
